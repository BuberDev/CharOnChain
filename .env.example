# CharOnChain — przykładowa konfiguracja środowiska.
# Skopiuj do .env.local (plik jest ignorowany przez git). NIE wpisuj tu prawdziwych sekretów.
#
# Zasady (docs/05 §4, CLAUDE.md pkt 9):
#  - zmienne NEXT_PUBLIC_* trafiają do przeglądarki — nigdy nie umieszczaj w nich kluczy,
#    service role, tokenów RPC z kluczem ani danych KYB;
#  - sekrety (puste poniżej) ustawiaj wyłącznie w menedżerze sekretów środowiska;
#  - osobne projekty Supabase/Vercel/RPC dla local/staging/production.

# --- Środowisko ---
# local | staging | production
APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Domyślnie Arbitrum Sepolia (421614). Arbitrum One (42161) wymaga jawnej decyzji właściciela.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=421614

# --- Publiczne (przeglądarka) ---
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publiczny (anon/publishable), chroniony przez RLS. To NIE jest service role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Publiczne endpointy RPC BEZ klucza API.
NEXT_PUBLIC_RPC_URL_421614=
NEXT_PUBLIC_RPC_URL_42161=

# --- Serwer / indexer (SEKRETY — pozostaw puste w repo) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Losowy sekret sesji, >= 32 bajty.
SESSION_SECRET=
# Prywatne RPC (z kluczem) — wyłącznie serwer/indexer.
RPC_URL_421614=
RPC_URL_42161=
# Liczba potwierdzeń i polityka finalności: do ustalenia w ADR-109 / COC-031 (bez wartości domyślnej).
INDEXER_CONFIRMATIONS=

# --- Account Abstraction (epik E6) ---
# Zmienne dostawcy (wallet/bundler/paymaster) zostaną dodane w COC-070/071 po zaakceptowaniu ADR-007.

# --- Deploy kontraktów ---
# NIE umieszczaj tutaj kluczy prywatnych ani seed phrase. Używaj keystore Foundry (cast wallet import)
# lub podpisu sprzętowego. Mainnet: wyłącznie po jawnej zgodzie właściciela i spełnieniu bramek z docs/05 §6.
